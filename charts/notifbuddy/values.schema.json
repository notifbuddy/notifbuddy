{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "notifbuddy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "domain": { "type": "string" },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dashboard": { "type": "string" },
        "api": { "type": "string" },
        "auth": { "type": "string" }
      }
    },
    "slack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientId": { "type": "string" },
        "clientSecret": { "type": "string" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "existingSecret": { "type": "string" },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "storage": { "type": "string" },
        "storageClass": { "type": "string" },
        "resources": { "type": "object" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "authUrl": { "type": "string" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" }
      }
    },
    "authd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string", "enum": ["text", "json"] },
        "level": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "axiom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "token": { "type": "string" },
            "dataset": { "type": "string" }
          }
        }
      }
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string" },
        "token": { "type": "string" },
        "serviceName": { "type": "string" }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slack": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "clientId": { "type": "string" },
            "clientSecret": { "type": "string" },
            "signingSecret": { "type": "string" }
          }
        },
        "linear": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "clientId": { "type": "string" },
            "clientSecret": { "type": "string" },
            "webhookSecret": { "type": "string" }
          }
        },
        "cloudflare": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "accountId": { "type": "string" },
            "apiToken": { "type": "string" },
            "model": { "type": "string" }
          }
        },
        "email": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "resendApiKey": { "type": "string" },
            "from": { "type": "string" }
          }
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chatwoot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "baseUrl": { "type": "string" },
            "websiteToken": { "type": "string" },
            "hmacToken": { "type": "string" }
          }
        }
      }
    },
    "podAnnotations": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
